# Для Docker: скопируйте в .env и задайте собственный пароль (12–72 байта).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
PUBLIC_ORIGINS=http://localhost:8080,http://localhost:5173
# Для размещения за HTTPS-прокси установите true.
COOKIE_SECURE=false
# Для сайта на GitHub Pages укажите HTTPS-адрес Go-сервера, без /api.
# VITE_API_URL=https://api.example.com
